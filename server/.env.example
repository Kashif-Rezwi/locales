# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/locales?sslmode=require

# ─── Workspace Isolation (E2B) ────────────────────────────────────────────────
# Required for Chunk 8 (Workspace Provider)
# Get your key from: https://e2b.dev/dashboard
E2B_API_KEY=your_e2b_api_key_here

# ─── LLM (PR description generation) ─────────────────────────────────────────
# Used only for writing PR descriptions — not pipeline orchestration
# Get your key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ─── Translation Providers (Chunk 6) ─────────────────────────────────────────
# At least one provider key is required for translation to work.
# The provider router will use whichever keys are configured, in priority order.

# Lingo.dev — https://lingo.dev/dashboard
LINGO_API_KEY=your_lingo_api_key_here

# DeepL — https://www.deepl.com/account/summary
DEEPL_API_KEY=your_deepl_api_key_here

# Google Translate — https://console.cloud.google.com
GOOGLE_TRANSLATE_KEY=your_google_translate_key_here

# OpenAI (GPT-4) — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
